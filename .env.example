TELEGRAM_TOKEN=
# Универсальные настройки OpenAI-совместимого LLM API.
# Старые DEEPSEEK_* ниже остаются рабочими для обратной совместимости.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_DISABLE_THINKING=true

DEEPSEEK_API_KEY=
BRAVE_SEARCH_API_KEY=
E621_USER_AGENT="ProtogenDelta/0.1 (by Exichek; https://github.com/Exichek/Protogen-Delta)"
E621_REQUEST_INTERVAL_SECONDS=1.0
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

LOG_LEVEL=INFO
DATA_DIR=data

RATE_LIMIT_SECONDS=2.0
RATE_LIMIT_RETENTION_SECONDS=300.0

CONVERSATION_HISTORY_LIMIT=8
USER_STATE_RETENTION_SECONDS=86400.0

ADMIN_IDS=
CREATOR_ID=

# Фоновые сообщения: проверка, первое сообщение после паузы и базовый cooldown.
PROACTIVE_CHECK_SECONDS=300
PROACTIVE_IDLE_SECONDS=14400
PROACTIVE_COOLDOWN_SECONDS=86400

ART_CHAT_ID=

TELEGRAM_PROXY_URL=

# HTTPS-адрес будущей Telegram Mini App. Если пусто, бот покажет обычное меню.
MINI_APP_URL=
# Встроенный aiohttp-сервер включайте за HTTPS reverse proxy.
MINI_APP_SERVER_ENABLED=false
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8080
MINI_APP_AUTH_MAX_AGE_SECONDS=3600
MINI_APP_DOMAIN=
# Внешний HTTPS-порт Compose/Caddy. Если 443 занят другим сервисом, например 8443.
MINI_APP_HTTPS_PORT=443
# OCR требует tesseract с языками rus+eng; Docker-образ уже содержит его.
PDF_OCR_ENABLED=false
# Отдельная аудиомодель (OpenAI-compatible input_audio), выключена до настройки.
AUDIO_UNDERSTANDING_ENABLED=false
AUDIO_API_KEY=
AUDIO_BASE_URL=
AUDIO_MODEL=
# false: чистый base64 (OpenRouter); true: data URL (Qwen-Omni).
AUDIO_INPUT_DATA_URL=false
# Поиск публикации арта через /source; не распознавание личности по лицу.
SAUCENAO_API_KEY=
# Файл нового Brave-ключа имеет приоритет над BRAVE_SEARCH_API_KEY.
BRAVE_SEARCH_API_KEY_FILE=

# Редкие реакции из локально размеченного стикерпака.
STICKER_PACK_ENABLED=true
STICKER_REACTION_CHANCE=0.35
STICKER_COOLDOWN_SECONDS=180
STICKER_MIN_REPLIES=3

# AudD: необязательное распознавание музыки по первым 12 секундам
MUSIC_AUDD_API_TOKEN=
