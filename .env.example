TELEGRAM_TOKEN=
# Универсальные настройки OpenAI-совместимого LLM API.
# Старые DEEPSEEK_* ниже остаются рабочими для обратной совместимости.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_DISABLE_THINKING=true
# Размышления для отдельных сложных ответов; поддерживаются с LLM_PROVIDER=deepseek.
LLM_ADAPTIVE_THINKING=true

DEEPSEEK_API_KEY=
BRAVE_SEARCH_API_KEY=
E621_USER_AGENT="ProtogenDelta/0.1 (by Exichek; https://github.com/Exichek/Protogen-Delta)"
E621_REQUEST_INTERVAL_SECONDS=1.0
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

LOG_LEVEL=INFO
DATA_DIR=data

RATE_LIMIT_SECONDS=2.0
# Общий суточный лимит API-попыток LLM на пользователя; сутки по Москве.
LLM_DAILY_REQUEST_LIMIT=300
# Персональные квоты: JSON с Telegram ID в ключах, например {"123456789":1000}.
LLM_DAILY_REQUEST_LIMIT_OVERRIDES={}
# Суммарный потолок API-попыток всех аккаунтов и служебных вызовов, сутки по Москве.
LLM_GLOBAL_DAILY_REQUEST_LIMIT=3000
# Необязательный личный Telegram ID владельца для предупреждений 80% и 100%.
LLM_BUDGET_ALERT_USER_ID=
RATE_LIMIT_RETENTION_SECONDS=300.0

CONVERSATION_HISTORY_LIMIT=8
CONVERSATION_HISTORY_TTL_SECONDS=604800
USER_STATE_RETENTION_SECONDS=86400.0

ADMIN_IDS=
CREATOR_ID=
CREATOR_IDS=
# Только эти аккаунты имеют чтение Python-исходников и команду /code_review в личном чате.
CODE_REVIEW_USER_IDS=
# Аккаунты, для которых Дельта сохраняет выбранные сообщения в отдельное избранное.
FAVORITES_USER_IDS=

# Фоновые сообщения: проверка, первое сообщение после паузы и базовый cooldown.
PROACTIVE_CHECK_SECONDS=300
PROACTIVE_IDLE_SECONDS=14400
PROACTIVE_COOLDOWN_SECONDS=86400

ART_CHAT_ID=

TELEGRAM_PROXY_URL=

# Необязательная сессия YouTube в Netscape cookies.txt. Пусто — анонимный доступ.
# В Compose: YOUTUBE_COOKIES_FILE=/run/secrets/youtube_cookies
# и YOUTUBE_COOKIES_HOST_FILE=<приватный файл на хосте>.
YOUTUBE_COOKIES_FILE=
YOUTUBE_COOKIES_HOST_FILE=

# HTTPS-адрес будущей Telegram Mini App. Если пусто, бот покажет обычное меню.
MINI_APP_URL=
# Встроенный aiohttp-сервер включайте за HTTPS reverse proxy.
MINI_APP_SERVER_ENABLED=false
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8080
MINI_APP_AUTH_MAX_AGE_SECONDS=3600
MINI_APP_DOMAIN=
# Внешний HTTPS-порт Compose/Caddy. Если 443 занят другим сервисом, например 8443.
MINI_APP_HTTPS_PORT=443
# OCR требует tesseract с языками rus+eng; Docker-образ уже содержит его.
PDF_OCR_ENABLED=false
# Отдельная аудиомодель (OpenAI-compatible input_audio), выключена до настройки.
AUDIO_UNDERSTANDING_ENABLED=false
AUDIO_API_KEY=
AUDIO_BASE_URL=
AUDIO_MODEL=
# false: чистый base64 (OpenRouter); true: data URL (Qwen-Omni).
AUDIO_INPUT_DATA_URL=false
# Поиск публикации арта через /source; не распознавание личности по лицу.
SAUCENAO_API_KEY=
# Основной поиск DeepSeek; Brave используется при недоступности основного API.
DEEPSEEK_SEARCH_ENABLED=true
# Необязательно: отдельный ключ DeepSeek. Иначе используется ключ официального LLM API.
DEEPSEEK_SEARCH_API_KEY=
# Общие попытки Search/Fetch/резервного Brave в сутки по Москве, отдельно от LLM.
WEB_API_DAILY_LIMIT=200
# Только вызовы Brave из этого приложения за календарный месяц по Москве.
BRAVE_MONTHLY_SEARCH_LIMIT=1000
# Файл нового Brave-ключа имеет приоритет над BRAVE_SEARCH_API_KEY.
BRAVE_SEARCH_API_KEY_FILE=

# Редкие реакции из локально размеченного стикерпака.
# Нативные эмодзи под сообщением в личном диалоге, отдельно от стикеров.
MESSAGE_REACTIONS_ENABLED=true
MESSAGE_REACTION_CHANCE=0.35
MESSAGE_REACTION_COOLDOWN_SECONDS=120
STICKER_PACK_ENABLED=true
STICKER_REACTION_CHANCE=0.35
STICKER_COOLDOWN_SECONDS=180
STICKER_MIN_REPLIES=3

# Распознавание музыки: shazam (по умолчанию, без ключа), audd или off.
MUSIC_RECOGNITION_PROVIDER=shazam
# Только для явного выбора audd; автоматического перехода на AudD нет.
MUSIC_AUDD_API_TOKEN=

# Живая инициатива: разные поводы, не больше двух отправлений в сутки,
# пауза от четырёх часов; после инициативы без ответа повтор не отправляется.
# false возвращает прежний режим. Разрешение пользователя сохраняется отдельно.
PROACTIVE_LIVELY_ENABLED=true
# Одна попытка подобрать проверенную новость за сутки на диалог. Поиск входит в общие квоты.
PROACTIVE_NEWS_ENABLED=true
# Необязательное короткое дополнение к обычному ответу: цель 5–15 с, до 4 анализов/сутки.
REPLY_SUPPLEMENTS_ENABLED=true

# Полный текст личной переписки и поиск: только выбранные Telegram ID через запятую.
# Пусто — архивирование выключено. Группы и чужие аккаунты не архивируются.
DIALOGUE_ARCHIVE_USER_IDS=

# Инициатива после паузы: выбранный один раз срок 1,5–3 часа.
PROACTIVE_CHECK_SECONDS=30
PROACTIVE_IDLE_SECONDS=5400
PROACTIVE_IDLE_MAX_SECONDS=10800
# Только прежний режим (PROACTIVE_LIVELY_ENABLED=false): один повтор через 20 часов.
PROACTIVE_COOLDOWN_SECONDS=72000

# Общая память только для явно подтверждённых аккаунтов одного владельца.
# Все ID группы также должны входить в DIALOGUE_ARCHIVE_USER_IDS.
# Пример формата с условными ID: 101,202;303,404. По умолчанию связи отключены.
DIALOGUE_SHARED_GROUPS=

# Раздел «Рынки»: пара серверных ключей Alpaca для акций США/ETF и криптокотировок.
# Российские акции и калькулятор валют работают без этой пары. Не добавлять реальные ключи в Git.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
